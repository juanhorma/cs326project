<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="/output.css">
    <title>DIVELOG HOME</title>
  </head>
  <body class="min-h-screen bg-slate-950 bg-[url('/background.jpg')] bg-cover bg-fixed bg-center text-slate-100 antialiased">
        <div class="mx-auto max-w-6xl px-4 py-6 sm:px-6 lg:px-8">
      <header class="mb-10 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-cyan-300">DIVELOG</p>
          <h1 class="text-3xl font-bold text-white sm:text-4xl">Welcome to DIVELOG!</h1>
        </div>
        <%- include('partials/navigate') %>
      </header>

      <main class="grid gap-4 sm:grid-cols-2">
        <a href="/dives" class="rounded-2xl bg-slate-900/80 p-6 ring-1 ring-white/10 backdrop-blur transition hover:ring-cyan-400/60">
          <h2 class="text-xl font-semibold text-white">Dive log</h2>
          <p class="mt-2 text-slate-300">Record each dive's date, time, depth and conditions, and search your dives by location.</p>
        </a>
        <a href="/buddies" class="rounded-2xl bg-slate-900/80 p-6 ring-1 ring-white/10 backdrop-blur transition hover:ring-cyan-400/60">
          <h2 class="text-xl font-semibold text-white">Dive buddies</h2>
          <p class="mt-2 text-slate-300">Keep track of the people you dive with and their certifications.</p>
        </a>
      </main>
    </div>
  </body>
</html>
