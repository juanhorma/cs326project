<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="/output.css" />
    <title>DIVELOG - Dive Buddies</title>
  </head>
  <body class="min-h-screen bg-slate-950 bg-[url('/background.jpg')] bg-cover bg-fixed bg-center text-slate-100 antialiased">
    <div class="mx-auto max-w-6xl px-4 py-6 sm:px-6 lg:px-8">
      <header class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-cyan-300">DIVELOG</p>
          <h1 class="text-3xl font-bold text-white sm:text-4xl">Dive Buddies</h1>
        </div>
        <%- include('partials/navigate') %>
      </header>

    <main class="grid gap-6 md:grid-cols-[20rem_minmax(0,1fr)] md:items-start lg:grid-cols-[22rem_minmax(0,1fr)]">
        <section class="rounded-2xl bg-slate-900/80 p-5 ring-1 ring-white/10 backdrop-blur md:sticky md:top-6">
          <h2 class="mb-4 text-lg font-semibold text-white">Add a buddy</h2>

          <form id="buddy-entry" class="grid grid-cols-1 gap-3 sm:grid-cols-2 md:grid-cols-1">
                    <label class="flex flex-col gap-1 text-sm text-slate-300 sm:col-span-2 md:col-span-1">
              Name
              <input type="text" name="name" placeholder="Buddy name" maxlength="100" required
                class="w-full rounded-lg border border-white/15 bg-slate-950/60 px-3 py-2 text-slate-100 placeholder:text-slate-500 focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400/40 focus:outline-none" />
            </label>
            <label class="flex flex-col gap-1 text-sm text-slate-300">
              Certification
              <input type="text" name="certification" placeholder="PADI Open Water"
                class="w-full rounded-lg border border-white/15 bg-slate-950/60 px-3 py-2 text-slate-100 placeholder:text-slate-500 focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400/40 focus:outline-none" />
            </label>
            <label class="flex flex-col gap-1 text-sm text-slate-300">
              Email
              <input type="email" name="email" placeholder="buddy@example.com"
                class="w-full rounded-lg border border-white/15 bg-slate-950/60 px-3 py-2 text-slate-100 placeholder:text-slate-500 focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400/40 focus:outline-none" />
            </label>
            <button type="submit"
              class="mt-1 bg-cyan-500 px-4 py-2.5 font-semibold text-slate-950 transition hover:bg-cyan-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300 disabled:cursor-not-allowed disabled:opacity-60 sm:col-span-2 md:col-span-1">
              Add buddy
            </button>
      </form>

      <p id="form-error" role="alert" class="mt-3 text-sm text-rose-300"></p>
        </section>

        <section class="min-w-0">

      <p id="buddies-empty" class="rounded-2xl bg-slate-900/80 p-6 text-center text-slate-300 ring-1 ring-white/10 backdrop-blur"<% if (buddies.length > 0) { %> hidden<% } %>>No dive buddies saved yet.</p>

      <ul id="buddies" class="grid grid-cols-1 gap-3 sm:grid-cols-2 md:grid-cols-1 lg:grid-cols-2">
        <% buddies.forEach((buddy) => {  %>
          <li class="buddy-item rounded-2xl bg-slate-900/80 p-4 ring-1 ring-white/10 backdrop-blur">
            <h3 class="text-lg font-semibold text-white"><%= buddy.name %> </h3>
            <% if (buddy.certification) { %><p class="mt-1 text-sm break-all text-slate-300">Certification: <%= buddy.certification %></p><% } %>
            <% if (buddy.email) { %><p class="mt-1 text-sm break-all text-slate-300">Email: <%= buddy.email %></p><% } %>
          </li>
        <% }) %>
      </ul>
    </section>
    </main>
    </div>
    <script src="/buddies.js" defer></script>
  </body>
</html>
