<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="stylesheet" href="/style.css">
    <title>DIVELOG</title>
    <%# title specific to this page%>
    <meta
      name="htmx-config"
      content='{
        "timeout": 5000,
        "responseHandling": [
          { "code": "204", "swap": false },
          { "code": "[23]..", "swap": true },
          { "code": "[45]..", "swap": true, "error": true, "target": "#status", "swapOverride": "innerHTML" }
        ]
      }'
    >
    <script src="https://unpkg.com/htmx.org@2.0.4"></script>
  </head>
  <body
    hx-on::send-error="document.querySelector('#status').textContent = 'Could not reach the server.'"
    hx-on::timeout="document.querySelector('#status').textContent = 'The server did not answer within five seconds.'"
  >
    <h1 style="color: white;">Dive Logger</h1>
    <%- include('partials/navigate') %>

    <main>
      <form id="dive-entry">
        <input type="date" name="date" required/>
        <input
          type="number"
          name="diveTime"
          placeholder="Dive time in minutes"
          min="1"
          required
        />
        <input type="number" name="maxDepth" placeholder="Maximum depth (m)" min="0.1" step="any" required/>
        <input type="text" name="location" placeholder="Location" />
        <input type="text" name="equipment" placeholder="Equipment used" />
        <input
          type="number"
          name="decompressionTime"
          placeholder="Decompression time in minutes"
          min="0"
        />
        <input type="text" name="notes" placeholder="Notes" />
        <button type="submit">Add dive entry</button>
      </form>


      <p id="form-error"></p>

      <%- include('partials/search-location-form') %>

      <ul id="dives">
        <%- include('partials/dive-list', { dives }) %>
      </ul>
    </main>
    <script src="/app.js" defer></script>
  </body>
</html>
