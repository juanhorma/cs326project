<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="stylesheet" href="/style.css">
    <title>DIVELOG</title>
    <%# title specific to this page%>
  </head>
  <body>
      <h1 style="color: white;">Dive Logger</h1>
      <nav class="site-nav"><a href="/dives">Dive log</a> <a href="/buddies">Dive buddies</a></nav>

      <form id="dive-entry">
        <input type="date" name="date" required/>
        <input
          type="number"
          name="diveTime"
          placeholder="Dive time in minutes"
          min="1"
          required
        />
        <input type="number" name="maxDepth" placeholder="Maximum depth (m)" min="0.1" step="any" required/>
        <input type="text" name="location" placeholder="Location" />
        <input type="text" name="equipment" placeholder="Equipment used" />
        <input
          type="number"
          name="decompressionTime"
          placeholder="Decompression time in minutes"
          min="0"
        />
        <input type="text" name="notes" placeholder="Notes" />
        <button type="submit">Add dive entry</button>
      </form>


      <p id="form-error"></p>

      <form id="search-location" method="GET" action="/dives">
          <input type="text" name="location" placeholder="Search Location">
          <button type="submit">Search</button>
          <a href="/dives">Show all</a>
      </form>

      <% if (dives.length === 0) { %>
        <p id="search-message">No matching dives found.</p>
      <% } %>

      <ul id="dives">
      <%
          const keyNames = {
            "date": "Date",
            "diveTime": "Dive Time",
            "maxDepth": "Maximum Depth",
            "location": "Location",
            "equipment": "Equipment",
            "decompressionTime": "Decompression Time",
            "notes": "Notes"
          };
        %>
        <% dives.forEach((dive) => {%>
          <li class="dive-item">
            <details class="dive-details" name="dives-accordion">
              <summary class="dive-summary">
                <div class="summary-content">
                  <h3>Date: <%= dive.date %></h3>
                  <h3>Dive Time: <%= dive.diveTime %></h3>
                  <h3>Maximum Depth: <%= dive.maxDepth %></h3>
                </div>
              </summary>


              <div class="full-content">
                <% for (const [key, keyAlias] of Object.entries(keyNames)) {%>
                  <% if (dive[key] !== undefined &&
                          dive[key] !== null &&
                          dive[key] !== "" &&
                          key != "date" &&
                          key != "diveTime" &&
                          key != "maxDepth") {%>
                    <h3><%= keyAlias%> : <%= dive[key] %></h3>
                  <%}%>
                <%}%>

              </div>

            </details>
          </li>
        <%})%>


      </ul>


    <script src="/app.js" defer></script>
  </body>
</html>
