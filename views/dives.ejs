<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>DIVELOG</title>
  </head>

  <body>
    <main>
      <h1>Add a Dive Entry</h1>

      <form id="dive-entry">
        <input type="date" name="date" />
        <input
          type="number"
          name="diveTime"
          placeholder="Dive time in minutes"
        />
        <input type="number" name="maxDepth" placeholder="Maximum depth" />
        <input type="text" name="location" placeholder="Location" />
        <input type="text" name="equipment" placeholder="Equipment used" />
        <input
          type="number"
          name="decompressionTime"
          placeholder="Decompression time"
        />
        <input type="text" name="notes" placeholder="Notes" />
        <button type="submit">Add dive entry</button>
      </form>

      <p id="form-error"></p>
      <div id="saved-dive"></div>
    </main>

    <script src="/app.js" defer></script>
  </body>
</html>
