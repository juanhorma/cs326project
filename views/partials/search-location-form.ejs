<form
  id="search-location"
  hx-get="/dives"
  hx-target="#dives"
  hx-swap="innerHTML"
  hx-disabled-elt="find button"
>
  <input type="text" name="location" placeholder="Search Location">
  <button type="submit">Search</button>

  <button
    id="show-all-button"
    type="button"
    hx-get="/dives"
    hx-target="#dives"
    hx-swap="innerHTML"
    hx-params="none"
    onclick="this.form.reset()"
  >
    Show all
  </button>
</form>
