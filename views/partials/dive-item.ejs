<li class="dive-item">
  <details class="group rounded-2xl bg-slate-900/80 ring-1 ring-white/10 backdrop-blur transition open:ring-cyan-400/40" name="dives-accordion">
    <summary class="flex cursor-pointer list-none items-center gap-4 p-4 [&::-webkit-details-marker]:hidden">
      <div class="grid flex-1 grid-cols-2 gap-x-4 gap-y-2 sm:grid-cols-3">
        <div class="col-span-2 sm:col-span-1">
          <p class="text-xs uppercase tracking-wide text-slate-400">Date</p>
          <p class="font-semibold text-white"><%= dive.date %></p>
        </div>
        <div>
          <p class="text-xs uppercase tracking-wide text-slate-400">Dive time</p>
          <p class="font-semibold text-white"><%= dive.diveTime %> min</p>
        </div>
        <div>
          <p class="text-xs uppercase tracking-wide text-slate-400">Max depth</p>
          <p class="font-semibold text-white"><%= dive.maxDepth %> m</p>
        </div>
      </div>
      <span aria-hidden="true" class="text-xl text-cyan-300 transition-transform group-open:rotate-180">▾</span>
    </summary>


    <div class="border-t border-white/10 px-4 pt-3 pb-4">
      <dl class="grid grid-cols-1 gap-x-6 gap-y-2 text-sm sm:grid-cols-2">
      <% for (const [key, keyAlias] of Object.entries(keyNames)) {%>
         <% if (dive[key] !== undefined &&
                dive[key] !== null &&
                dive[key] !== "" &&
                key != "date" &&
                key != "diveTime" &&
                key != "maxDepth") {%>
            <div>
              <dt class="text-xs uppercase tracking-wide text-slate-400"><%= keyAlias %></dt>
              <dd class="break-words text-slate-100"><%= dive[key] %></dd>
            </div>
        <%}%>
      <%}%>
      </dl>
          <a href="/dives/<%= dive.id %>" class="mt-4 inline-block font-medium text-cyan-300 underline-offset-4 hover:text-cyan-200 hover:underline">View dive →</a>

    </div>

  </details>
</li>
