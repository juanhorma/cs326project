<% if (dives.length === 0) { %>
  <li id="search-message" class="rounded-2xl bg-slate-900/80 p-6 text-center text-slate-300 ring-1 ring-white/10 backdrop-blur">No matching dives found.</li>
<% } %>

<%
  const keyNames = {
    "date": "Date",
    "diveTime": "Dive Time",
    "maxDepth": "Maximum Depth",
    "location": "Location",
    "equipment": "Equipment",
    "decompressionTime": "Decompression Time",
    "notes": "Notes"
  };
%>
<% dives.forEach((dive) => {%>
  <%- include('dive-item', { dive, keyNames }) %>
<%})%>
