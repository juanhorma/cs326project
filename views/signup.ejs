
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <title>Sign up - DIVELOG</title>
  </head>
  <body>
    <main>
      <h1>Sign up</h1>

      <form method="POST" action="/signup">
        <% if (error) { %>
          <p role="alert"><%= error %></p>
        <% } %>

        <label for="signup-email">Email</label>
        <input
          type="email"
          id="signup-email"
          name="email"
          value="<%= email %>"
          autocomplete="email"
          required
        >

        <label for="signup-password">Password</label>
        <input
          type="password"
          id="signup-password"
          name="password"
          autocomplete="new-password"
          required
        >

        <button type="submit">Sign up</button>
      </form>

      <p>Already have an account? <a href="/login">Log in</a>.</p>
    </main>
  </body>
</html>
